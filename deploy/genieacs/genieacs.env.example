# Template for /etc/genieacs/genieacs.env, read by the genieacs-cwmp, genieacs-nbi
# and genieacs-fs units through EnvironmentFile=.
#
# This file holds no secrets. render-env.sh fills each placeholder (a name in
# double braces) from the environment, and prints nothing while one is missing
# (README step 4):
#   out=$(deploy/genieacs/render-env.sh) &&
#     printf '%s\n' "$out" | sudo install -o root -g genieacs -m 0640 /dev/stdin /etc/genieacs/genieacs.env
#
# systemd syntax: one KEY=value per line, no quotes, no spaces around "=".
# GenieACS reads every variable that starts with GENIEACS_.

# MongoDB runs on 127.0.0.1 with authorization enabled; create-users.js made this
# account. The password is hex so it needs no escaping inside the URL.
GENIEACS_MONGODB_CONNECTION_URL=mongodb://genieacs:{{ACS_DB_PASSWORD}}@127.0.0.1:27017/genieacs?authSource=genieacs

# CWMP is the only port routers need. It listens on every address because this
# host moves between networks; ufw decides which networks get in (README step 7),
# and cwmp.auth decides which routers are accepted.
GENIEACS_CWMP_INTERFACE=::
GENIEACS_CWMP_PORT=7547
GENIEACS_CWMP_WORKER_PROCESSES=2

# The NBI has no authentication and hands out cwmp.auth, users and every device
# to whoever reaches it (CVE-2025-56015). Loopback only; the unit also pins this
# on the command line, which wins over this file.
GENIEACS_NBI_INTERFACE=127.0.0.1
GENIEACS_NBI_PORT=7557
GENIEACS_NBI_WORKER_PROCESSES=2

# File server for firmware pushes (phase 3; its unit is installed but not enabled).
# It has no authentication either.
GENIEACS_FS_INTERFACE=::
GENIEACS_FS_PORT=7567
# Unset, download URLs use the address the router used to reach CWMP, which follows
# this host between networks. Set it only behind a proxy or when FS runs elsewhere.
#GENIEACS_FS_URL_PREFIX=http://10.10.0.2:7567/

# genieacs-ui is never run. If it is ever started by mistake it stays on loopback,
# and with no GENIEACS_UI_JWT_SECRET it cannot issue logins.
GENIEACS_UI_INTERFACE=127.0.0.1

GENIEACS_EXT_DIR=/opt/genieacs/ext

GENIEACS_LOG_FORMAT=json
GENIEACS_CWMP_LOG_FILE=/var/log/genieacs/cwmp.log
GENIEACS_CWMP_ACCESS_LOG_FILE=/var/log/genieacs/cwmp-access.log
GENIEACS_NBI_LOG_FILE=/var/log/genieacs/nbi.log
GENIEACS_NBI_ACCESS_LOG_FILE=/var/log/genieacs/nbi-access.log
GENIEACS_FS_LOG_FILE=/var/log/genieacs/fs.log
GENIEACS_FS_ACCESS_LOG_FILE=/var/log/genieacs/fs-access.log

NODE_OPTIONS=--enable-source-maps

# Key for the connection-request passwords ext/skyrouter.js derives per router.
# Hex, at least 32 characters; without it the extension refuses every call and
# the skybre-inform channel shows an ext.Error fault.
SKYROUTER_CR_SECRET={{SKYROUTER_CR_SECRET}}

# Never set GENIEACS_DEBUG_FILE outside a lab: it dumps SOAP traffic, including
# Wi-Fi passphrases.
