# Template for /etc/skyrouter/router-manager.env, read by router-manager.service.
# Install it 0640 root:skyrouter and fill in the password; it holds no secrets as shipped.

# Dashboard login. Left empty, the server still starts but refuses logins and
# API calls with 503, so a forgotten password fails closed.
ROUTER_MANAGER_USERNAME=admin
ROUTER_MANAGER_PASSWORD=

# GenieACS NBI. Remove this line to run without TR-069 support, exactly as before.
# Loopback only: the NBI has no authentication, and SkyRouter refuses a remote
# ACS URL unless ROUTER_MANAGER_ACS_ALLOW_REMOTE=1 is also set.
ROUTER_MANAGER_ACS_URL=http://127.0.0.1:7557
# Seconds between router check-ins, set by the skybre-inform preset.
ROUTER_MANAGER_ACS_INFORM_INTERVAL=300
# After a Wi-Fi password change is acknowledged, re-read it so GenieACS's
# plaintext copy in MongoDB becomes "".
ROUTER_MANAGER_ACS_SCRUB_SECRETS=1
